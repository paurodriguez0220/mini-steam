{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "MaxRequests": 100
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "MiniSteamAPI",
    "Audience": "MiniSteamClient",
    "DurationInMinutes": 60
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "GameIconsContainer": "game-icons",
    "UserAvatarsContainer": "user-avatars",
    "MaxFileSizeInMB": 5,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ]
  }
}
