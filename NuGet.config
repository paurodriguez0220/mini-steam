<?xml version="1.0" encoding="utf-8"?>
<!-- Isolates this personal project from corporate NuGet feeds inherited from the
     machine-level config. Without <clear /> restores silently attempt private ADO
     feeds and fail with 401s that look like network errors. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
