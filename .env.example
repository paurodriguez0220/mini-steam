# Copy to .env before running docker compose:  cp .env.example .env
# These values are for LOCAL DEVELOPMENT ONLY. Never reuse them anywhere else.

# JWT signing key. Must be at least 32 characters.
JWT_KEY=local-development-signing-key-change-me-32+

# Account seeded into the local database and used by the storefront to sign in.
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=Local_Dev_Pa55word!

# Pinned images. Digests are authoritative; the tag is kept for readability.
# Bump deliberately - 'latest' makes a rebuild non-reproducible.
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:latest@sha256:76b8127d608fab8287a14a4bfeb9a5502cdcffb4bf1e86f09f324ebb0e70edba

# Host port mappings - change if any of these clash with something already running.
API_PORT=8085
UI_PORT=5173
GAME_2048_PORT=5174
GAME_SNAKE_PORT=5175
GAME_MINESWEEPER_PORT=5176
GAME_TICTACTOE_PORT=5177
GAME_FIVER_PORT=5178
AZURITE_PORT=10000
