# Copy to .env.local and fill in. Never commit real values.
# Base URL of the MiniSteam API (no trailing slash).
VITE_API_URL=https://localhost:7157

# Storefront service-account credentials used to obtain a JWT.
# NOTE: these are bundled into the client build and are therefore public.
# See docs/tasks/queue/remove-client-side-credentials.md - this is tracked for removal.
VITE_API_AUTH_USERNAME=
VITE_API_AUTH_PASSWORD=
